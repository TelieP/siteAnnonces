{% extends 'base.html.twig' %}

{% block title %}Mon Compte - {{ app.user.username }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="mb-4 fw-bold"><i class="bi bi-person-gear me-2"></i>Mon Compte</h1>
            
            <div class="card shadow-sm border-0 p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm fw-bold" style="width: 80px; height: 80px; font-size: 1.8rem;">
                        {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                    </div>
                    <div class="ms-4">
                        <h3 class="mb-0 fw-bold">{{ app.user.firstName }} {{ app.user.lastName }}</h3>
                        <p class="text-muted mb-0">Bonjour  {{ app.user.username }}</p>
                    </div>
                </div>

                <hr class="my-4">

                <h5 class="fw-bold mb-3 text-primary">Informations personnelles</h5>
                <div class="row g-3">
                    <div class="col-sm-4 text-muted">Prénom</div>
                    <div class="col-sm-8 fw-semibold">{{ app.user.firstName }}</div>

                    <div class="col-sm-4 text-muted">Nom</div>
                    <div class="col-sm-8 fw-semibold">{{ app.user.lastName }}</div>

                    <div class="col-sm-4 text-muted">Nom d'utilisateur</div>
                    <div class="col-sm-8 fw-semibold text-primary">{{ app.user.username }}</div>

                    <div class="col-sm-4 text-muted">Adresse Email</div>
                    <div class="col-sm-8 fw-semibold">{{ app.user.email }}</div>
                </div>
                {# templates/profile/account.html.twig #}
                <div class="col-sm-4 text-muted">Téléphone</div>
                    <div class="col-sm-8 fw-semibold">
                    {{ app.user.phoneNumber ? app.user.phoneNumber : 'Non renseigné' }}
                    </div>

                <div class="mt-5 d-flex gap-2">
                    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-pencil-square me-2"></i>Modifier le profil
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-danger rounded-pill px-4">
                        <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
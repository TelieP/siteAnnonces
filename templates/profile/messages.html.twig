{% extends 'base.html.twig' %}

{% block title %}Mes Messages {% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="fw-bold mb-4"><i class="bi bi-chat-dots me-2 text-primary"></i>Ma Messagerie</h1>

    {# Système d'onglets Bootstrap #}
    <ul class="nav nav-pills mb-4 shadow-sm p-2 bg-white rounded" id="messageTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="received-tab" data-bs-toggle="pill" data-bs-target="#received" type="button" role="tab">
                Messages reçus <span class="badge bg-danger ms-1">{{ receivedMessages|length }}</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="sent-tab" data-bs-toggle="pill" data-bs-target="#sent" type="button" role="tab">
                Messages envoyés
            </button>
        </li>
    </ul>

    <div class="tab-content" id="messageTabContent">
        {# SECTION MESSAGES REÇUS #}
        <div class="tab-pane fade show active" id="received" role="tabpanel">
            {% for msg in receivedMessages %}
                <div class="card shadow-sm border-0 mb-3 overflow-hidden">
                    <div class="row g-0">
                        <div class="col-md-2 bg-light d-flex align-items-center justify-content-center p-3">
                            <div class="text-center">
                                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                                    {{ msg.sender.email|first|upper }}
                                </div>
                                <div class="small fw-bold text-truncate" style="max-width: 100px;">{{ msg.sender.email }}</div>
                            </div>
                        </div>

                        {# Dans ta boucle for message in receivedMessages #}
    <div class="card mb-3 {% if not msg.isRead %}border-primary border-3{% endif %}">
        <div class="card-body">
        <h5 class="card-title">{{ msg.ad.title }}</h5>
        <p class="card-text">{{ msg.content }}</p>
        <p class="small text-muted">Envoyé par : {{ msg.sender.userIdentifier }}</p>
        
        <div class="d-flex gap-2">
            {# Le bouton Répondre appelle maintenant 'app_message_read' pour passer le message en "LU" #}
            <a href="{{ path('app_message_read', {id: msg.id}) }}" class="btn btn-sm btn-primary">
                <i class="bi bi-reply"></i> Répondre
            </a>

            {# Le bouton Supprimer #}
            <a href="{{ path('app_message_delete', {id: msg.id}) }}" 
               class="btn btn-sm btn-outline-danger" 
               onclick="return confirm('Supprimer ce message définitivement ?')">
                <i class="bi bi-trash"></i>
            </a>
        </div>
    </div>
</div>
                        <div class="col-md-10">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0">Annonce : <a href="{{ path('app_ad_show', {id: msg.ad.id}) }}" class="text-decoration-none">{{ msg.ad.title }}</a></h6>
                                    <small class="text-muted">{{ msg.createdAt|date('d/m/Y à H:i') }}</small>
                                </div>
                                <p class="card-text text-secondary bg-light p-3 rounded italic">
                                    " {{ msg.content }} "
                                </p>
                                <div class="text-end">
                                    <a href="{{ path('app_message_read', {id: msg.id}) }}" class="btn btn-sm btn-primary">
                                        <i class="bi bi-reply"></i> Répondre
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <p class="text-muted italic">Vous n'avez pas encore reçu de messages.</p>
                </div>
            {% endfor %}
        </div>

        {# SECTION MESSAGES ENVOYÉS #}
        <div class="tab-pane fade" id="sent" role="tabpanel">
            {% for msg in sentMessages %}
                <div class="card shadow-sm border-0 mb-2 opacity-75">
                    <div class="card-body py-2">
                        <div class="row align-items-center">
                            <div class="col-md-3 small">À : <strong>{{ msg.recipient.email }}</strong></div>
                            <div class="col-md-6 text-truncate text-muted"><em>{{ msg.content }}</em></div>
                            <div class="col-md-3 text-end small text-muted">{{ msg.createdAt|date('d/m/Y') }}</div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5 text-muted">Aucun message envoyé.</div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
    .nav-pills .nav-link.active { background-color: #4183d7; }
    .nav-pills .nav-link { color: #555; }
    .italic { font-style: italic; }
</style>
{% endblock %}
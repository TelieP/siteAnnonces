{% extends 'base.html.twig' %}

{% block title %}Inscription - Touni{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 p-4">
                <h1 class="h3 mb-4 fw-bold text-center">Créer un compte</h1>
                
                {{ form_errors(registrationForm) }}

                {{ form_start(registrationForm) }}
                    <div class="mb-3">
                        {{ form_row(registrationForm.email, {
                            'label': 'Votre adresse email',
                            'attr': {'class': 'form-control py-2'}
                        }) }}
                    </div>
                    
                    <div class="mb-3">
                        {{ form_row(registrationForm.firstName, {
                            'label': 'Votre prénom',
                            'attr': {'class': 'form-control py-2'}
                        }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(registrationForm.lastName, {
                            'label': 'Votre nom',
                            'attr': {'class': 'form-control py-2'}
                        }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(registrationForm.username, {
                            'label': 'Votre nom d\'utilisateur',
                            'attr': {'class': 'form-control py-2'}
                        }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(registrationForm.phoneNumber, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(registrationForm.plainPassword, {
                            'label': 'Choisissez un mot de passe',
                            'attr': {'class': 'form-control py-2'}
                        }) }}
                    </div>
                    <div class="form-check mb-4">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                        <label class="form-check-label small" for="{{ registrationForm.agreeTerms.vars.id }}">
                            J'accepte les conditions générales d'utilisation
                        </label>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 fw-bold py-2 text-white">S'inscrire</button>
                {{ form_end(registrationForm) }}

                <div class="text-center mt-4">
                    <p class="small text-muted">Déjà un compte ? <a href="{{ path('app_login') }}" class="text-primary fw-bold text-decoration-none">Connectez-vous</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
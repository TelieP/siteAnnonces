<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏠</text></svg>">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        
        <style>
            /* Force le footer en bas et permet la pleine largeur */
            body {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin: 0;
            }
            main {
                flex: 1; /* Prend tout l'espace disponible */
            }
            footer {
                width: 100%;
            }
        </style>

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    </head>
    <body data-turbo="false">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3 mb-4">
            <div class="container">
                <a class="navbar-brand fw-bolder text-warning text-uppercase" href="{{ path('app_ad_index') }}" style="letter-spacing: 1px;">
                    <i class="bi bi-shop-window me-2"></i>LES ANNONCES
                </a>

                <div class="ms-auto d-flex align-items-center">
                    {% if app.user %}
                        {% set unreadCount = app.user.receivedMessages|filter(m => m.isRead == false)|length %}
                        <div class="dropdown me-3">
                            <button class="btn btn-outline-dark dropdown-toggle border-0 fw-bold d-flex align-items-center position-relative" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px; font-size: 14px;">
                                    {{ app.user.firstName ? app.user.firstName|first|upper : '' }}{{ app.user.lastName ? app.user.lastName|first|upper : app.user.email|first|upper }}
                                </div>
                                {{ app.user.firstName ?: app.user.username ?: app.user.email }}
                                {% if unreadCount > 0 %}
                                    <span class="position-absolute top-0 start-0 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                                {% endif %}
                            </button>
                            
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userMenu">
                                <li><a class="dropdown-item py-2" href="{{ path('app_profile') }}"><i class="bi bi-collection me-2 text-primary"></i> Mes annonces</a></li>
                                <li><a class="dropdown-item py-2" href="{{ path('app_profile_account') }}"><i class="bi bi-person me-2"></i> Mon compte</a></li>
                                <li><a class="dropdown-item py-2" href="{{ path('app_profile_favorites') }}"><i class="bi bi-heart me-2 text-danger"></i> Mes favoris</a></li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex justify-content-between align-items-center" href="{{ path('app_profile_messages') }}">
                                        <span><i class="bi bi-chat-left-text me-2 text-primary"></i> Mes messages</span>
                                        {% if unreadCount > 0 %}<span class="badge rounded-pill bg-danger">{{ unreadCount }}</span>{% endif %}
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i> Déconnexion</a></li>
                            </ul>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-link text-dark text-decoration-none fw-bold me-3">Se connecter</a>
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm px-3 fw-bold rounded-pill border-0 me-3" style="background-color: #4183d7;">S'inscrire</a>
                    {% endif %}
                    <a href="{{ path('app_ad_new') }}" class="btn btn-warning fw-bold shadow-sm px-4 rounded-pill">
                        <i class="bi bi-plus-lg me-1"></i> Déposer une annonce
                    </a>
                </div>
            </div>
        </nav>
        

        {# L'élément main permet d'encapsuler le contenu et de laisser le footer libre #}
        <main>
            {% block body %}{% endblock %}
        </main>

        <footer class="bg-dark text-white pt-5 pb-4 mt-auto">
            <div class="container text-center text-md-start">
                <div class="row">
                    <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
                        <h5 class="text-uppercase mb-4 font-weight-bold text-warning">Les Annonces</h5>
                        <p>La plateforme idéale pour vendre et acheter vos objets d'occasion en toute sécurité.</p>
                    </div>

                    <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mt-3">
                        <h5 class="text-uppercase mb-4 font-weight-bold text-warning">Liens</h5>
                        <p><a href="{{ path('app_ad_index') }}" class="text-white text-decoration-none">Accueil</a></p>
                        <p><a href="#" class="text-white text-decoration-none">Catégories</a></p>
                        {% if is_granted('ROLE_ADMIN') %}
                            <p><a href="{{ path('app_admin_dashboard') }}" class="text-white text-decoration-none">Admin</a></p>
                        {% endif %}
                    </div>

                    <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
                        <h5 class="text-uppercase mb-4 font-weight-bold text-warning">Contact</h5>
                        <p><i class="bi bi-house mr-3"></i> Lézignan-Corbières, France</p>
                        <p><i class="bi bi-envelope mr-3"></i> contact@lesannonces.fr</p>
                        <p><i class="bi bi-phone mr-3"></i> +33 01 02 03 04 05</p>
                    </div>
                </div>
                <hr class="mb-4 opacity-25">
                <div class="row align-items-center">
                    <div class="col-md-7 col-lg-8">
                        <p>© {{ "now"|date("Y") }} Tous droits réservés par :
                            <a href="#" class="text-warning text-decoration-none"><strong>Les Annonces</strong></a>
                        </p>
                    </div>
                </div>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
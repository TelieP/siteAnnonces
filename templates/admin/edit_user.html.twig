{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-4">Modifier le profil de {{ user.email }}</h2>
                    
                    {{ form_start(form) }}
                        {{ form_widget(form) }}
                        <div class="d-grid gap-2 mt-4">
                            <button class="btn btn-primary rounded-pill">Enregistrer les modifications</button>
                            <a href="{{ path('admin_users_list') }}" class="btn btn-link text-muted">Annuler</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
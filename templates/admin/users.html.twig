{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold"><i class="bi bi-people me-2"></i>Liste des Utilisateurs</h1>
        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Retour Dashboard
        </a>
    </div>

   <div class="card shadow-sm border-0">
            <div class="table-responsive">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
         {% endfor %}
        {% endfor %}
        <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Identité</th>
                        <th>Email / Username</th>
                        <th>Rôles</th>
                        <th>Téléphone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>
                            <div class="fw-bold">{{ user.firstName }} {{ user.lastName|upper }}</div>
                        </td>
                        <td>
                            <div>{{ user.email }}</div>
                            <small class="text-muted">@{{ user.username }}</small>
                        </td>
                        <td>
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-danger">Admin</span>
                                {% else %}
                                    <span class="badge bg-secondary">Utilisateur</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>{{ user.phoneNumber ?: '<em>Non renseigné</em>'|raw }}</td>
                        <td>
                    {# Bouton Modifier #}
                    <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-dark" title="Modifier">
                    <i class="bi bi-pencil"></i>
                    </a>

                    {# Bouton Supprimer (Bannir) #}
                    {% if user != app.user %}
                    <a href="{{ path('admin_user_delete', {id: user.id}) }}" 
                    class="btn btn-sm btn-outline-danger" 
                    onclick="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?')" 
                    title="Supprimer">
                    <i class="bi bi-trash"></i>
                    </a>
                    {% endif %}
                    </td>>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
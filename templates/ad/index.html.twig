{% extends 'base.html.twig' %}

{% block title %}Accueil - Annonces{% endblock %}

{% block body %}
{# 1. HERO SECTION & FILTRES #}
<div class="py-5 mb-5 bg-light border-bottom shadow-sm" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-3">Bonjour, que recherchez-vous ?</h1>
        
        <div class="row justify-content-center mb-5">
            <div class="col-md-10">
                <form action="{{ path('app_ad_index') }}" method="get" class="row g-2 shadow-sm p-3 bg-white rounded">
                    <div class="col-md-4">
                        <input type="text" name="q" class="form-control border-0" placeholder="Que recherchez-vous ?" value="{{ app.request.query.get('q') }}">
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="l" class="form-control border-0" placeholder="Où ? (Ville)" value="{{ app.request.query.get('l') }}">
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="min" class="form-control border-0" placeholder="Prix min" value="{{ app.request.query.get('min') }}">
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="max" class="form-control border-0" placeholder="Prix max" value="{{ app.request.query.get('max') }}">
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-warning w-100 fw-bold">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        {# CATEGORIES #}
        <div class="d-flex justify-content-center flex-wrap gap-4 mt-4">
            {% for cat in categories %}
                <a href="{{ path('app_ad_index', {'category': cat.id}) }}" class="text-decoration-none text-dark category-item">
                    <div class="category-icon shadow-sm mb-2 mx-auto d-flex align-items-center justify-content-center bg-white rounded-circle" style="width: 60px; height: 60px;">
                        {% if 'auto' in cat.name|lower or 'voiture' in cat.name|lower %}
                            <i class="bi bi-car-front fs-3 text-info"></i>
                        {% elseif 'immo' in cat.name|lower %}
                            <i class="bi bi-house fs-3 text-info"></i>
                        {% elseif 'travail' in cat.name|lower or 'emploi' in cat.name|lower %}
                            <i class="bi bi-person-workspace fs-3 text-info"></i>
                        {% elseif 'trav' in cat.name|lower %}
                            <i class="bi bi-tools fs-3 text-info"></i>
                        {% elseif 'services' in cat.name|lower or 'serv' in cat.name|lower %}
                            <i class="bi bi-person-raised-hand fs-3 text-info"></i>
                        {% elseif 'informatique' in cat.name|lower or 'multimedia' in cat.name|lower %}
                            <i class="bi bi-laptop fs-3 text-info"></i>
                        {% elseif 'mobilier' in cat.name|lower or 'mob' in cat.name|lower %}
                            <i class="bi bi-box-seam-fill fs-3 text-info"></i>
                        {% else %}
                            <i class="bi bi-tag fs-3 text-warning"></i>
                        {% endif %}
                    </div>
                    <span class="small fw-bold">{{ cat.name }}</span>
                </a>
            {% endfor %}
        </div>
    </div>
</div>

<div class="container">
    {# Messages Flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Dernières annonces</h2>
        <a href="{{ path('app_ad_new') }}" class="btn btn-warning fw-bold shadow-sm">
            + Déposer une annonce
        </a>
    </div>

    {# GRILLE DES ANNONCES #}
    <div class="row">
        {% for ad in ads %}
            <div class="col-md-4 mb-4" id="ad-{{ ad.id }}">
                <div class="card h-100 shadow-sm border-0 overflow-hidden ad-card">
                    
                    <div class="position-relative">
                        {% if ad.images|length > 0 %}
                            <img src="{{ asset('uploads/images/' ~ ad.images[0].name) }}" 
                                 class="card-img-top" alt="{{ ad.title }}" 
                                 style="height: 220px; object-fit: cover;">
                        {% else %}
                            <img src="https://via.placeholder.com/400x250?text=Pas+d'image" 
                                 class="card-img-top" alt="placeholder"
                                 style="height: 220px; object-fit: cover;">
                        {% endif %}

                        <div class="position-absolute top-0 end-0 m-2">
                            {% if app.user %}
                                <a href="{{ path('app_ad_favorite', {id: ad.id}) }}" class="text-decoration-none">
                                    {% if ad in app.user.favorites %}
                                        <i class="bi bi-heart-fill text-danger fs-4 shadow"></i>
                                    {% else %}
                                        <i class="bi bi-heart text-white fs-4 shadow"></i>
                                    {% endif %}
                                </a>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="text-decoration-none">
                                    <i class="bi bi-heart text-white fs-4 shadow"></i>
                                </a>
                            {% endif %}
                        </div>
                        
                        <span class="badge bg-dark position-absolute bottom-0 start-0 m-2">
                            {{ ad.price }} €
                        </span>
                    </div>

                    <div class="card-body p-3">
                        <h5 class="fw-bold mb-1 text-truncate">{{ ad.title }}</h5>
                        <p class="small text-muted mb-2">
                            <i class="bi bi-tag me-1"></i>{{ ad.category.name }} 
                            | <i class="bi bi-geo-alt me-1 text-danger"></i>{{ ad.city|default('N/A') }}
                        </p>
                        <p class="card-text small text-secondary text-truncate-2">
                            {{ ad.description|slice(0, 80) }}...
                        </p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted">
                                {{ ad.createdAt|date('d/m/Y') }}
                            </small>
                            <a href="{{ path('app_ad_show', {id: ad.id}) }}" class="btn btn-outline-primary btn-sm">Voir plus</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="lead text-muted">Aucune annonce trouvée.</p>
            </div>
        {% endfor %}

    </div>

    {# Section Récemment consultés #}
{% if historyAds is not empty %}
    <div class="container mt-5">
        <h3>Récemment consultés</h3>
        <div class="row">
            {% for ad in historyAds %}
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        {% if ad.images is not empty %}
                            <img src="{{ asset('uploads/images/' ~ ad.images[0].name) }}" class="card-img-top" alt="{{ ad.title }}" style="height: 150px; object-fit: cover;">
                        {% else %}
                            <img src="https://via.placeholder.com/150" class="card-img-top" alt="Pas d'image">
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title text-truncate">{{ ad.title }}</h5>
                            <p class="text-primary fw-bold">{{ ad.price }} €</p>
                            <a href="{{ path('app_ad_show', {id: ad.id}) }}" class="btn btn-outline-primary btn-sm">Voir l'annonce</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
</div>

<style>
    .category-item { transition: all 0.2s; width: 80px; }
    .category-item:hover { transform: translateY(-5px); }
    .category-item:hover .category-icon { background-color: #ffca2c !important; }
    .ad-card { transition: transform 0.2s; }
    .ad-card:hover { transform: translateY(-5px); }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 40px;
    }
    .bi-heart, .bi-heart-fill {
        filter: drop-shadow(0px 0px 2px rgba(0,0,0,0.5));
    }
    .extra-small { font-size: 0.75rem; }

    /* Custom Scrollbar pour le carrousel horizontal */
    .custom-scrollbar::-webkit-scrollbar {
        height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #ffca2c;
        border-radius: 10px;
    }
    .custom-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: #ffca2c #f1f1f1;
    }
</style>
{% endblock %}
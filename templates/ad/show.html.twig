{% extends 'base.html.twig' %}

{% block title %}{{ ad.title }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_ad_index') }}">Accueil</a></li>
                    <li class="breadcrumb-item active">{{ ad.category.name }}</li>
                </ol>
            </nav>
            {# --- Section compteurs vues et favoris des annonces   --- #}
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h2 mb-0">{{ ad.title }}</h1> {# Tu peux déplacer le titre ici s'il était plus bas #}
                <div class="d-flex gap-3 text-muted">
                    <span class="badge bg-light text-dark border shadow-sm p-2">
                        <i class="bi bi-eye-fill text-primary"></i> {{ viewsCount }} {{ viewsCount > 1 ? 'vues' : 'vue' }}
                    </span>
                    <span class="badge bg-light text-dark border shadow-sm p-2">
                        <i class="bi bi-heart-fill text-danger"></i> {{ favoritesCount }} {{ favoritesCount > 1 ? 'favoris' : 'favori' }}
                    </span>
                </div>
            </div>

            <div class="card shadow-sm border-0 overflow-hidden mb-4">
                {# --- NOUVELLE GALERIE D'IMAGES --- #}
                <div class="position-relative bg-light">
                    {% if ad.images|length > 0 %}
                        {# Image principale #}
                        <img src="{{ asset('uploads/images/' ~ ad.images[0].name) }}" 
                             id="mainImg" 
                             class="img-fluid w-100" 
                             alt="{{ ad.title }}" 
                             style="height: 500px; object-fit: cover;">
                        
                        {# Miniatures (seulement s'il y en a plusieurs) #}
                        {% if ad.images|length > 1 %}
                            <div class="d-flex gap-2 p-2 bg-white border-top overflow-auto">
                                {% for image in ad.images %}
                                    <img src="{{ asset('uploads/images/' ~ image.name) }}" 
                                         class="img-thumbnail" 
                                         style="width: 80px; height: 60px; object-fit: cover; cursor: pointer;"
                                         onmouseover="document.getElementById('mainImg').src = this.src"
                                         onclick="document.getElementById('mainImg').src = this.src">
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% else %}
                        {# Image par défaut si aucune image galerie n'existe #}
                        <img src="https://placehold.co/800x500?text=Pas+d'image" 
                             class="img-fluid w-100" 
                             alt="Image par défaut">
                    {% endif %}
                </div>
                
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h1 class="fw-bold h2 mb-0">{{ ad.title }}</h1>
                        <span class="badge bg-success fs-5">{{ ad.price }} €</span>
                    </div>

                    {# Affichage de la ville #}
                    <p class="text-muted mb-3">
                        <i class="bi bi-geo-alt-fill text-danger"></i> {{ ad.city|default('Lieu non précisé') }}
                    </p>

                    <hr>
                    <h5 class="fw-bold mb-3">Description</h5>
                    <p class="text-muted" style="white-space: pre-line;">{{ ad.description }}</p>
                </div>
            </div>

            {# --- SECTION FORMULAIRE DE RÉPONSE --- #}
            <div id="contact" class="card shadow-sm border-0 mt-4 mb-5">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">
                        <i class="bi bi-envelope-paper-fill me-2 text-primary"></i>Répondre à cette annonce
                    </h4>
     
{# On boucle sur tous les messages de l'annonce pour afficher l'historique #}
{% for msg in ad.messages %}
    <div class="mb-4 p-3 border rounded bg-light">
        <p><strong>{{ msg.sender.username }} :</strong> {{ msg.content }}</p>

        {# Maintenant on peut utiliser 'msg' car on est dans la boucle #}
        {% if msg.images is not empty %}
            <div class="d-flex gap-3 flex-wrap mt-2">
                {% for img in msg.images %}
                    <div class="message-photo-container">
                        <img src="{{ asset('uploads/images/' ~ img.name) }}" 
                             class="rounded shadow-sm border" 
                             style="width: 100px; height: 100px; object-fit: cover;">

                        {# Bouton supprimer (uniquement pour l'auteur du message) #}
                        {% if app.user == msg.sender %}
                            <form method="post" action="{{ path('app_message_image_delete', {'id': img.id}) }}" 
                                  onsubmit="return confirm('Supprimer cette photo ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ img.id) }}">
                                <button type="submit" class="btn-delete-image">
                                    <i class="bi bi-x"></i>
                                </button>
                            </form>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endfor %}
        
                    {% if app.user %}
                        {% if app.user == ad.author %}
                            <div class="alert alert-info border-0 shadow-sm">
                                <i class="bi bi-info-circle me-2"></i>Ceci est votre annonce. Vous ne pouvez pas vous répondre à vous-même.
                            </div>
                        {% else %}
                            {% set formVar = contactForm is defined ? contactForm : (form is defined ? form : null) %}
                            
                            {% if formVar %}
                                    {{ form_start(formVar, {'attr': {'enctype': 'multipart/form-data'}}) }}

                                {# NOUVEAU CODE À METTRE À LA PLACE #}
                        <div class="mb-3">
                            <label class="form-label fw-bold">Votre message</label>
                            {{ form_widget(formVar.content, {
                                'attr': {
                                    'id': 'contact_message_field', 
                                    'class': 'form-control', 
                                    'rows': '5',
                                    'placeholder': 'Écrivez votre message au vendeur ici...'
                             }
                         }) }}
                         {{ form_errors(formVar.content) }}
</div>
                                  
                                    <button type="submit" class="btn btn-primary w-100 fw-bold mt-3 py-2 shadow-sm">
                                        <i class="bi bi-send me-2"></i>Envoyer un message
                                    </button>
                                {{ form_end(formVar) }}
                            {% else %}
                                <p class="text-danger">Erreur : Le formulaire de contact n'a pas pu être chargé.</p>
                            {% endif %}
                        {% endif %}
                    {% else %}
                        <div class="text-center py-4 bg-light rounded shadow-sm">
                            <p class="text-muted mb-3">Vous devez être connecté pour envoyer un message.</p>
                            <a href="{{ path('app_login') }}" class="btn btn-primary rounded-pill px-4 fw-bold">Se connecter</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# --- COLONNE VENDEUR (DROITE) --- #}
        <div class="col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-body p-4 text-center">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2rem;">
                        {{ ad.author.username|first|upper }}
                    </div>
                    <h5 class="fw-bold mb-1">{{ ad.author.username }}</h5>
                    
                    <p class="text-muted small mb-3">
                        {% if ad.updatedAt is defined and ad.updatedAt is not null %}
                            Annonce du {{ ad.updatedAt|date('d/m/Y') }}
                        {% else %}
                            Membre actif
                        {% endif %}
                    </p>
                    
                    <hr>
                    <div class="d-grid gap-2">
                        <a href="#contact" class="btn btn-warning fw-bold shadow-sm" onclick="focusMessageField(event)">
                            <i class="bi bi-chat-dots me-2"></i>Contacter le vendeur
                        </a>

                        {% if ad.showPhone and ad.author.phoneNumber %}
                            <a href="tel:{{ ad.author.phoneNumber }}" class="btn btn-outline-dark fw-bold shadow-sm">
                                <i class="bi bi-telephone me-2"></i> {{ ad.author.phoneNumber }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

   
    

        {# --- ANNONCES SIMILAIRES --- #}
<h3 class="mt-5 mb-4">Annonces similaires</h3>
<div class="row flex-nowrap overflow-auto pb-3">
    {% for item in similarAds %}
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                {# On récupère la première image de la collection #}
                {% set firstImage = item.images|first %}
                
                {% if firstImage %}
                    <img src="{{ asset('uploads/images/' ~ firstImage.name) }}" 
                         class="card-img-top" 
                         style="height: 180px; object-fit: cover;"
                         alt="{{ item.title }}">
                {% else %}
                    {# Image par défaut si aucune image n'est associée #}
                    <img src="https://picsum.photos/300/180" 
                         class="card-img-top" 
                         alt="Image par défaut">
                {% endif %}

                <div class="card-body">
                    <h6 class="fw-bold text-truncate">{{ item.title }}</h6>
                    <p class="text-danger fw-bold">{{ item.price }} €</p>
                    <a href="{{ path('app_ad_show', {id: item.id}) }}" 
                       class="btn btn-outline-primary btn-sm w-100">Voir l'article</a>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
</div>
</div>
 
{% endblock %}
{% block javascripts %}
<script>
    function focusMessageField(event) {
        // Délai de 600ms pour laisser le temps au scroll de finir
        setTimeout(() => {
            const field = document.getElementById('contact_content');
            
            if (field) {
                // On place le curseur dans le champ
                field.focus();
                
                // On force le style avec !important pour écraser Bootstrap
                field.style.setProperty('transition', 'all 0.5s ease-in-out');
                field.style.setProperty('border', '3px solid #ffc107', 'important');
                field.style.setProperty('box-shadow', '0 0 15px rgba(255, 193, 7, 0.6)', 'important');
                
                // On retire l'effet après 2 secondes
                setTimeout(() => {
                    field.style.removeProperty('border');
                    field.style.removeProperty('box-shadow');
                }, 2000);
            }
        }, 600);
    }
</script>
{% endblock %}